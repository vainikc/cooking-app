{
  "expo": {
    "name": "AI Cooking Teacher",
    "slug": "ai-cooking-teacher",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "aicookingteacher",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bitcode": false,
      "bundleIdentifier": "com.aicookingteacher.devlimkp",
      "infoPlist": {
        "NSCameraUsageDescription": "The chef uses your camera to check your cooking.",
        "NSMicrophoneUsageDescription": "Talk to the chef hands-free while you cook.",
        "UIBackgroundModes": [
          "audio"
        ]
      },
      "appleTeamId": "4H678C39QM"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.aicookingteacher.devlimkp",
      "permissions": [
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.CAMERA",
        "android.permission.INTERNET",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WAKE_LOCK",
        "android.permission.BLUETOOTH"
      ],
      "softwareKeyboardLayoutMode": "pan"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "@livekit/react-native-expo-plugin",
      "@config-plugins/react-native-webrtc",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
